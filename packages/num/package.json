{
    "name": "@tolki/num",
    "version": "2.2.4",
    "description": "Utilities for working with numbers similar to Laravel's Num class facade.",
    "author": "Abraham Arango <https://github.com/abetwothree>",
    "license": "MIT",
    "homepage": "https://tolki.abe.dev/numbers/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/abetwothree/tolki.git",
        "directory": "packages/num"
    },
    "bugs": {
        "url": "https://github.com/abetwothree/tolki/issues"
    },
    "type": "module",
    "main": "src/index.ts",
    "scripts": {
        "build": "vite build",
        "readme:build": "ts-node ../../scripts/readme-build.ts --filter @tolki/num",
        "prepack": "pnpm run readme:build && pnpm run build",
        "postpublish": "sh ../../scripts/github-release.sh"
    },
    "keywords": [
        "number",
        "numbers",
        "num",
        "laravel",
        "utils",
        "utilities"
    ],
    "sideEffects": false,
    "packageManager": "pnpm@10.12.1",
    "dependencies": {
        "@tolki/utils": "workspace:^",
        "to-words": "^5.0.0"
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "main": "dist/index.js",
        "types": "dist/index.d.ts",
        "exports": {
            ".": {
                "import": "./dist/index.js",
                "require": "./dist/index.js",
                "types": "./dist/index.d.ts"
            },
            "./*": {
                "import": "./dist/*",
                "require": "./dist/*",
                "types": "./dist/*"
            },
            "./num": {
                "types": "./dist/num.d.ts",
                "import": "./dist/num.js",
                "default": "./dist/num.js"
            },
            "./speller": {
                "types": "./dist/speller/index.d.ts",
                "import": "./dist/speller/index.js",
                "default": "./dist/speller/index.js"
            }
        }
    },
    "tolki": {
        "docs": [
            "numbers/index.md",
            "numbers/number-utilities-list.md"
        ]
    }
}

{
    "name": "@tolki/arr",
    "version": "1.0.2",
    "description": "A utility for working with arrays.",
    "author": "Abraham Arango <https://github.com/abetwothree>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/abetwothree/tolki.git",
        "directory": "packages/arr"
    },
    "bugs": {
        "url": "https://github.com/abetwothree/tolki/issues"
    },
    "type": "module",
    "main": "src/index.ts",
    "scripts": {
        "build": "vite build",
        "readme:build": "ts-node ../../scripts/readme-build.ts --filter @tolki/arr",
        "prepack": "pnpm run readme:build && pnpm run build",
        "postpublish": "sh ../../scripts/github-release.sh"
    },
    "keywords": [
        "array",
        "arrays",
        "arr",
        "laravel",
        "utils",
        "utilities"
    ],
    "dependencies": {
        "@tolki/enum": "workspace:^",
        "@tolki/obj": "workspace:^",
        "@tolki/path": "workspace:^",
        "@tolki/str": "workspace:^",
        "@tolki/types": "workspace:^",
        "@tolki/utils": "workspace:^"
    },
    "sideEffects": false,
    "packageManager": "pnpm@10.12.1",
    "files": [
        "dist"
    ],
    "publishConfig": {
        "main": "dist/index.js",
        "types": "dist/index.d.ts",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "./arr": {
                "types": "./dist/arr.d.ts",
                "default": "./dist/arr.js"
            }
        }
    },
    "tolki": {
        "docs": [
            "arrays-objects/index.md",
            "arrays-objects/utilities-list.md",
            "arrays-objects/dot-notation.md",
            "arrays-objects/php-semantics.md",
            "arrays-objects/differences.md"
        ]
    }
}

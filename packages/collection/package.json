{
    "name": "@tolki/collection",
    "version": "1.0.1",
    "description": "A collection utility similar to Laravel's Collection class.",
    "author": "Abraham Arango <https://github.com/abetwothree>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/abetwothree/tolki.git",
        "directory": "packages/collection"
    },
    "bugs": {
        "url": "https://github.com/abetwothree/tolki/issues"
    },
    "type": "module",
    "main": "src/index.ts",
    "scripts": {
        "build": "vite build",
        "readme:build": "ts-node ../../scripts/readme-build.ts --filter @tolki/collection",
        "prepack": "pnpm run readme:build && pnpm run build",
        "postpublish": "sh ../../scripts/github-release.sh"
    },
    "keywords": [
        "collection",
        "collections",
        "laravel",
        "utils",
        "utilities"
    ],
    "dependencies": {
        "@tolki/data": "workspace:^",
        "@tolki/enum": "workspace:^",
        "@tolki/path": "workspace:^",
        "@tolki/types": "workspace:^",
        "@tolki/utils": "workspace:^"
    },
    "devDependencies": {
        "@tolki/arr": "workspace:^",
        "@tolki/str": "workspace:^"
    },
    "sideEffects": false,
    "packageManager": "pnpm@10.12.1",
    "files": [
        "dist"
    ],
    "publishConfig": {
        "main": "dist/index.js",
        "types": "dist/index.d.ts",
        "exports": {
            ".": {
                "import": "./dist/index.js",
                "require": "./dist/index.js",
                "types": "./dist/index.d.ts"
            },
            "./collection": {
                "types": "./dist/collection.d.ts",
                "import": "./dist/collection.js",
                "default": "./dist/collection.js"
            }
        }
    },
    "tolki": {
        "docs": [
            "collections/index.md",
            "collections/methods-list.md",
            "collections/differences.md"
        ]
    }
}

{
    "name": "@tolki/path",
    "version": "1.0.0",
    "description": "Utilities for working with path-based operations across arrays/objects.",
    "author": "Abraham Arango <https://github.com/abetwothree>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/abetwothree/tolki.git",
        "directory": "packages/path"
    },
    "bugs": {
        "url": "https://github.com/abetwothree/tolki/issues"
    },
    "type": "module",
    "main": "src/index.ts",
    "scripts": {
        "build": "vite build",
        "prepack": "pnpm run build",
        "postpublish": "sh ../../scripts/github-release.sh"
    },
    "keywords": [
        "path",
        "array",
        "object",
        "utilities",
        "dot-notation"
    ],
    "dependencies": {
        "@tolki/utils": "workspace:^",
        "@tolki/types": "workspace:^"
    },
    "sideEffects": false,
    "packageManager": "pnpm@10.12.1",
    "files": [
        "dist"
    ],
    "publishConfig": {
        "main": "dist/index.js",
        "types": "dist/index.d.ts",
        "exports": {
            ".": {
                "import": "./dist/index.js",
                "require": "./dist/index.js",
                "types": "./dist/index.d.ts"
            },
            "./path": {
                "types": "./dist/path.d.ts",
                "import": "./dist/path.js",
                "default": "./dist/path.js"
            },
            "./pluck": {
                "types": "./dist/pluck.d.ts",
                "import": "./dist/pluck.js",
                "default": "./dist/pluck.js"
            }
        }
    }
}

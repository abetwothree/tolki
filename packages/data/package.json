{
    "name": "@tolki/data",
    "version": "1.0.1",
    "description": "Utilities for working with various data structures in JavaScript.",
    "author": "Abraham Arango <https://github.com/abetwothree>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/abetwothree/tolki.git",
        "directory": "packages/data"
    },
    "bugs": {
        "url": "https://github.com/abetwothree/tolki/issues"
    },
    "type": "module",
    "main": "src/index.ts",
    "scripts": {
        "build": "vite build",
        "readme:build": "ts-node ../../scripts/readme-build.ts --filter @tolki/data",
        "prepack": "pnpm run readme:build && pnpm run build",
        "postpublish": "sh ../../scripts/github-release.sh"
    },
    "keywords": [
        "data",
        "structures",
        "data-structures",
        "laravel",
        "utils",
        "utilities"
    ],
    "dependencies": {
        "@tolki/arr": "workspace:^",
        "@tolki/obj": "workspace:^",
        "@tolki/types": "workspace:^",
        "@tolki/utils": "workspace:^"
    },
    "sideEffects": false,
    "packageManager": "pnpm@10.12.1",
    "files": [
        "dist"
    ],
    "publishConfig": {
        "main": "dist/index.js",
        "types": "dist/index.d.ts",
        "exports": {
            ".": {
                "import": "./dist/index.js",
                "require": "./dist/index.js",
                "types": "./dist/index.d.ts"
            },
            "./data": {
                "import": "./dist/data.js",
                "types": "./dist/data.d.ts"
            }
        }
    },
    "tolki": {
        "docs": [
            "arrays-objects/index.md",
            "arrays-objects/utilities-list.md",
            "arrays-objects/dot-notation.md",
            "arrays-objects/php-semantics.md",
            "arrays-objects/differences.md"
        ]
    }
}

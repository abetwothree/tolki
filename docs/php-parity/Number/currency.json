{
    "meta": {
        "php": "8.5.9",
        "laravel": "v13.43.0-17-g1caec34a34"
    },
    "probes": [
        {
            "label": "currency-rounds-to-zero",
            "php": "Number::currency(-0.001)",
            "value": "$0.00"
        },
        {
            "label": "currency-float-noise",
            "php": "Number::currency(0.1 + 0.2 - 0.3 - 0.0000000001)",
            "value": "$0.00"
        },
        {
            "label": "currency-rounds-to-zero-no-digits",
            "php": "Number::currency(-0.4, precision: 0)",
            "value": "$0"
        },
        {
            "label": "currency-keeps-sign",
            "php": "Number::currency(-0.006)",
            "value": "-$0.01"
        },
        {
            "label": "currency-negative-zero",
            "php": "Number::currency(-0.0)",
            "value": "$0.00"
        },
        {
            "label": "currency-rounds-to-zero-eur-de",
            "php": "Number::currency(-0.001, in: 'EUR', locale: 'de')",
            "value": "0,00\u00a0\u20ac"
        },
        {
            "label": "currency-locale-spellings",
            "php": "Number::currency(1234.5, 'EUR', \u2026) for pt_BR, pt-BR and ar_EG",
            "value": {
                "pt_BR": "\u20ac\u00a01.234,50",
                "pt-BR": "\u20ac\u00a01.234,50",
                "ar_EG": "\u200f\u0661\u066c\u0662\u0663\u0664\u066b\u0665\u0660\u00a0\u20ac"
            }
        },
        {
            "label": "currency-locale-unknown",
            "php": "Number::currency(1234.5, 'EUR', 'xx')",
            "threw": "ValueError",
            "message": "NumberFormatter::__construct(): Argument #1 ($locale) \"xx\" is invalid"
        }
    ]
}

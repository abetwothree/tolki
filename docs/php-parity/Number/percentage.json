{
    "meta": {
        "php": "8.5.9",
        "laravel": "v13.43.0-17-g1caec34a34"
    },
    "probes": [
        {
            "label": "percentage-rounds-to-zero",
            "php": "Number::percentage(-0.4)",
            "value": "0%"
        },
        {
            "label": "percentage-rounds-to-zero-one-digit",
            "php": "Number::percentage(-0.04, precision: 1)",
            "value": "0.0%"
        },
        {
            "label": "percentage-keeps-sign-one-digit",
            "php": "Number::percentage(-0.4, precision: 1)",
            "value": "-0.4%"
        },
        {
            "label": "percentage-keeps-sign",
            "php": "Number::percentage(-5)",
            "value": "-5%"
        },
        {
            "label": "percentage-max-precision-rounds-to-zero",
            "php": "Number::percentage(-0.004, maxPrecision: 2)",
            "value": "0%"
        },
        {
            "label": "percentage-locale-spellings",
            "php": "Number::percentage(12.5, 1, locale: \u2026) for pt_BR and pt-BR",
            "value": {
                "pt_BR": "12,5%",
                "pt-BR": "12,5%"
            }
        },
        {
            "label": "percentage-locale-unknown",
            "php": "Number::percentage(12.5, locale: 'xx')",
            "threw": "ValueError",
            "message": "NumberFormatter::__construct(): Argument #1 ($locale) \"xx\" is invalid"
        }
    ]
}

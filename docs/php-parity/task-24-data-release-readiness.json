    "probes": [
        {
            "label": "boolean-string-value",
            "php": "Arr::boolean(['string' => 'foo bar'], 'string')",
            "threw": "InvalidArgumentException",
            "message": "Array value for key [string] must be a boolean, string found."
        },
        {
            "label": "float-string-value",
            "php": "Arr::float(['string' => 'foo bar'], 'string')",
            "threw": "InvalidArgumentException",
            "message": "Array value for key [string] must be a float, string found."
        },
        {
            "label": "integer-string-value",
            "php": "Arr::integer(['string' => 'foo bar'], 'string')",
            "threw": "InvalidArgumentException",
            "message": "Array value for key [string] must be an integer, string found."
        },
        {
            "label": "integer-float-value",
            "php": "Arr::integer(['a' => 1.5], 'a')",
            "threw": "InvalidArgumentException",
            "message": "Array value for key [a] must be an integer, double found."
        },

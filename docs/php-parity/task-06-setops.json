{
    "meta": {
        "php": "8.5.9",
        "laravel": "v13.25.0-10-g0015ce4753"
    },
    "probes": [
        {
            "label": "intersect \u2014 values only, left keys",
            "php": "$c->intersect([...])",
            "value": {
                "first_word": "Hello"
            }
        },
        {
            "label": "diff \u2014 values only",
            "php": "$c->diff([\"x\"=>\"Hello\"])",
            "value": {
                "id": 1
            }
        },
        {
            "label": "diff is case-sensitive",
            "php": "$c->diff([...])",
            "value": [
                "en_GB",
                "fr",
                "HR"
            ]
        },
        {
            "label": "intersect(null)",
            "php": "$c->intersect(null)",
            "value": []
        },
        {
            "label": "intersectAssoc \u2014 key AND value",
            "php": "$c->intersectAssoc([...])",
            "value": {
                "a": "green"
            }
        },
        {
            "label": "intersectByKeys(null)",
            "php": "$c->intersectByKeys(null)",
            "value": []
        },
        {
            "label": "intersectAssoc(null)",
            "php": "$c->intersectAssoc(null)",
            "value": []
        },
        {
            "label": "intersectAssocUsing(null)",
            "php": "$c->intersectAssocUsing(null, $cb)",
            "value": []
        },
        {
            "label": "diffAssoc \u2014 key AND value (must stay unchanged)",
            "php": "$c->diffAssoc([...])",
            "value": {
                "id": 1,
                "first_word": "Hello"
            }
        },
        {
            "label": "diffAssoc \u2014 case-sensitive keys (must stay unchanged)",
            "php": "$c->diffAssoc([...])",
            "value": {
                "a": "green",
                "b": "brown",
                "c": "blue",
                "0": "red"
            }
        },
        {
            "label": "diff(null) returns items unchanged",
            "php": "$c->diff(null)",
            "value": {
                "id": 1,
                "first_word": "Hello"
            }
        },
        {
            "label": "intersect on array-backed collection",
            "php": "$c->intersect([2,4,6])",
            "value": {
                "1": 2,
                "3": 4
            }
        },
        {
            "label": "diff on array-backed collection",
            "php": "$c->diff([2,4])",
            "value": {
                "0": 1,
                "2": 3
            }
        },
        {
            "label": "diffAssoc on array-backed collection",
            "php": "$c->diffAssoc([1,9,3])",
            "value": {
                "1": 2
            }
        }
    ]
}

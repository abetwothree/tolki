{
    "meta": {
        "php": "8.5.9",
        "laravel": "v13.25.0-10-g0015ce4753"
    },
    "probes": [
        {
            "label": "X1 pop mutates and returns the last value",
            "php": "collect([10,20,30,40])->pop()",
            "value": {
                "pop": 40,
                "after": [
                    10,
                    20,
                    30
                ],
                "pop2": [
                    40,
                    30
                ],
                "after2": [
                    10,
                    20
                ]
            }
        },
        {
            "label": "X2 shift mutates and returns the first value",
            "php": "collect([10,20,30,40])->shift()",
            "value": {
                "shift": 10,
                "after": [
                    20,
                    30,
                    40
                ],
                "shift2": [
                    10,
                    20
                ],
                "after2": [
                    30,
                    40
                ]
            }
        },
        {
            "label": "X3 shift throws on a negative count",
            "php": "collect([10,20,30,40])->shift(-1)",
            "threw": "InvalidArgumentException",
            "message": "Number of shifted items may not be less than zero."
        },
        {
            "label": "X4 shift on empty returns null for any count",
            "php": "collect([])->shift(3)",
            "value": {
                "count3": null,
                "count1": null
            }
        },
        {
            "label": "X5 unshift mutates and renumbers integer keys",
            "php": "collect([10,20,30,40])->unshift(1,2)",
            "value": [
                1,
                2,
                10,
                20,
                30,
                40
            ]
        },
        {
            "label": "X6 splice mutates and returns the removed items",
            "php": "collect([10,20,30,40])->splice(1,2)",
            "value": {
                "removed": [
                    20,
                    30
                ],
                "after": [
                    10,
                    40
                ]
            }
        },
        {
            "label": "X7 splice one-arg form removes offset to end",
            "php": "collect([10,20,30,40])->splice(1)",
            "value": {
                "removed": [
                    20,
                    30,
                    40
                ],
                "after": [
                    10
                ]
            }
        },
        {
            "label": "X8 splice keeps string keys, reindexes integer keys",
            "php": "array_splice(['x'=>1,'y'=>2,'z'=>3],1,1)",
            "value": {
                "strRemoved": {
                    "y": 2
                },
                "strAfter": {
                    "x": 1,
                    "z": 3
                },
                "intRemoved": [
                    "b"
                ],
                "intAfter": [
                    "a",
                    "c"
                ]
            }
        },
        {
            "label": "X9 replace does not mutate",
            "php": "collect([10,20,30,40])->replace([1=>'d'])",
            "value": {
                "result": [
                    10,
                    "d",
                    30,
                    40
                ],
                "source": [
                    10,
                    20,
                    30,
                    40
                ]
            }
        },
        {
            "label": "X10 replaceRecursive does not mutate",
            "php": "collect([[a=>1],[b=>2]])->replaceRecursive([[c=>3]])",
            "value": {
                "result": [
                    {
                        "a": 1,
                        "c": 3
                    },
                    {
                        "b": 2
                    }
                ],
                "source": [
                    {
                        "a": 1
                    },
                    {
                        "b": 2
                    }
                ]
            }
        },
        {
            "label": "X11 replace/replaceRecursive treat null as a no-op",
            "php": "collect([10,20,30,40])->replace(null)",
            "value": {
                "replace": [
                    10,
                    20,
                    30,
                    40
                ],
                "replaceRecursive": [
                    10,
                    20,
                    30,
                    40
                ]
            }
        },
        {
            "label": "X12 intersect compares values only",
            "php": "collect([10,20,30,40])->intersect([20,40])",
            "value": {
                "1": 20,
                "3": 40
            }
        },
        {
            "label": "X13 diff compares values only",
            "php": "collect([10,20,30,40])->diff([20,40])",
            "value": {
                "0": 10,
                "2": 30
            }
        },
        {
            "label": "X14 intersect variants treat null as empty",
            "php": "collect([10,20,30,40])->intersect(null)",
            "value": {
                "intersect": [],
                "intersectAssoc": [],
                "intersectByKeys": []
            }
        },
        {
            "label": "X15 slice with a negative offset and a length",
            "php": "collect([10,20,30,40])->slice(-3,2)",
            "value": {
                "1": 20,
                "2": 30
            }
        },
        {
            "label": "X16 filter drops PHP-falsy \"0\" but keeps \"00\" and \"0.0\"",

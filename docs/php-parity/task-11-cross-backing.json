                "noPad": [
                    10,
                    20,
                    30,
                    40
                ]
            }
        },
        {
            "label": "X19 combine throws on a key/value count mismatch",
            "php": "array_combine(['a','b'],[1])",
            "threw": "ValueError",
            "message": "array_combine(): Argument #1 ($keys) and argument #2 ($values) must have the same number of elements"
        },
        {
            "label": "X19 combine on matching counts",
            "php": "collect(['a','b','c'])->combine([1,2,3])",
            "value": {
                "a": 1,
                "b": 2,
                "c": 3
            }
        },
        {
            "label": "X20 union lets the left operand win, null value included",
            "php": "['a'=>null] + ['a'=>1]",

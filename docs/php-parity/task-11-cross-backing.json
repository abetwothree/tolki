                "ints": [
                    0,
                    0,
                    10,
                    20,
                    30,
                    40
                ]
            }
        },
        {
            "label": "X18/pad positive padding appends",
            "php": "collect([10,20,30,40])->pad(6,0)",
            "value": {
                "padded": [

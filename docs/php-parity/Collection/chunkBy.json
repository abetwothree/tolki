                    [
                        2,
                        "c"
                    ]
                ],
                [
                    "a"
                ],
                [
                    [
                        1,
                        "b"
                    ]
                ]
            ]
        },
        {
            "label": "chunkBy-out-of-order-runs",
            "php": "(new Collection([2 => 1, 0 => 1, 1 => 2]))->chunkBy(fn ($v, $k) => $v)",
            "value": [
                [
                    [
                        2,
                        1

        {
            "label": "chunkBy-mixed-runs-callback-order",
            "php": "(new Collection(['x' => 1, 0 => 1, 'y' => 2]))->chunkBy(fn ($v, $k) => $v) => keys seen",
            "value": [
                0,
                "x",
                "y",
                0
            ]
        },
        {
            "label": "chunkBy-mixed-runs",
            "php": "(new Collection(['x' => 1, 0 => 1, 'y' => 2]))->chunkBy(fn ($v, $k) => $v)",
            "value": [
                [

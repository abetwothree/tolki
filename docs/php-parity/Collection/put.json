        {
            "label": "C32-B-put-float-key-on-list",
            "php": "$c = collect([1, 2]); @$c->put(1.5, 3); $c->all()",
            "value": [
                1,
                3
            ]
        },
        {
            "label": "C32-B-put-bool-key-on-list",
            "php": "$c = collect([1, 2]); $c->put(true, 3); $c->all()",
            "value": [
                1,
                3
            ]
        },
        {
            "label": "C32-B-put-length-zero-on-list",
            "php": "$c = collect([1, 2]); $c->put('length', 0); views",
            "value": {
                "all": {
                    "0": 1,
                    "1": 2,
                    "length": 0
                },
                "count": 3,
                "keys": [
                    0,
                    1,
                    "length"
                ],
                "values": [
                    1,
                    2,
                    0
                ],
                "get": 0,
                "has": true,
                "last": 0
            }
        },
        {
            "label": "C32-B-put-method-name-then-push",
            "php": "$c = collect([1, 2]); $c->put('push', 9)->push(3); $c->all()",
            "value": {
                "0": 1,
                "1": 2,
                "push": 9,
                "2": 3
            }
        },
        {
            "label": "C32-B-put-string-key-then-pop",
            "php": "$c = collect([1, 2]); $c->put('x', 3); $c->pop()",
            "value": {
                "returned": 3,
                "all": [
                    1,
                    2
                ]
            }
        },
        {
            "label": "C32-B-put-string-key-then-shift",
            "php": "$c = collect([1, 2]); $c->put('x', 3); $c->shift()",
            "value": {
                "returned": 1,
                "all": {
                    "0": 2,
                    "x": 3
                }
            }
        },
        {
            "label": "C32-B-put-string-key-then-push",
            "php": "$c = collect([1, 2]); $c->put('x', 3)->push(4); $c->all()",
            "value": {
                "0": 1,
                "1": 2,
                "x": 3,
                "2": 4
            }
        },
        {
            "label": "C32-B-put-string-key-then-transform",
            "php": "$c = collect([1, 2]); $c->put('x', 3)->transform(fn ($v) => $v * 10)->all()",
            "value": {
                "0": 10,
                "1": 20,
                "x": 30
            }
        },
        {
            "label": "C32-B-put-int-key-onto-string-keyed-order",
            "php": "$c = collect(['a' => 1]); $c->put(0, 'z'); keys/values/last",
            "value": {
                "keys": [
                    "a",
                    0
                ],
                "values": [
                    1,
                    "z"
                ],
                "last": "z"
            }
        },
        {
            "label": "C32-B-put-illegal-key",
            "php": "put($key, 9) and offsetSet($key, 9) over collect(['a', 'b']) and collect(['a' => 1, 'b' => 2]), for $key = ['a'], new stdClass and fn () => 1",
            "value": {
                "array": {
                    "put": [
                        {
                            "outcome": [

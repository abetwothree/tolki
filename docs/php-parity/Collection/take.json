            "label": "collection-take-negative-keeps-keys",
            "php": "(new Collection(['taylor','dayle','shawn']))->take(-2)",
            "value": {
                "1": "dayle",
                "2": "shawn"
            }
        },
        {
            "label": "collection-take-positive-keeps-keys",
            "php": "(new Collection(['taylor','dayle','shawn']))->take(2)",
            "value": [
                "taylor",
                "dayle"
            ]
        },
        {
            "label": "collection-take-zero",
            "php": "(new Collection(['taylor','dayle','shawn']))->take(0)",
            "value": []

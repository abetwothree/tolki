{
    "meta": {
        "php": "8.5.9",
        "laravel": "v13.35.0-45-g01ac36d93a"
    },
    "probes": [
        {
            "label": "replace does not mutate",
            "php": "$c->replace([\"b\"=>2])",
            "value": {
                "result": {
                    "a": 1,
                    "b": 2
                },
                "source": {
                    "a": 1
                }
            }
        },
        {
            "label": "replace(null)",
            "php": "$c->replace(null)",
            "value": {
                "a": 1,
                "b": 2,
                "c": 3
            }
        },
        {
            "label": "replace array does not mutate",
            "php": "$c->replace([9])",
            "value": {
                "result": [
                    9,
                    2
                ],
                "source": [
                    1,
                    2
                ]
            }
        },
        {
            "label": "replace array (null)",
            "php": "$c->replace(null)",
            "value": [
                1,
                2,
                3
            ]
        },
        {
            "label": "X9 replace does not mutate",
            "php": "collect([10,20,30,40])->replace([1=>'d'])",
            "value": {
                "result": [
                    10,
                    "d",
                    30,
                    40
                ],
                "source": [
                    10,
                    20,
                    30,
                    40
                ]
            }
        },
        {
            "label": "X11 replace/replaceRecursive treat null as a no-op",
            "php": "collect([10,20,30,40])->replace(null)",
            "value": {
                "replace": [
                    10,
                    20,
                    30,
                    40
                ],
                "replaceRecursive": [
                    10,
                    20,
                    30,
                    40
                ]
            }
        },
        {
            "label": "C16 replace assoc",
            "php": "(new Collection(['name' => 'amir', 'family' => 'otwell']))->replace(['name' => 'taylor', 'age' => 26])->all()",
            "value": {
                "name": "taylor",
                "family": "otwell",
                "age": 26
            }
        },
        {
            "label": "C23 replace int-keyed replacer on int-keyed",
            "php": "(new Collection(['a', 'b', 'c']))->replace([1 => 'd', 2 => 'e', 3 => 'f', 4 => 'g'])->all()",
            "value": [
                "a",
                "d",
                "e",
                "f",
                "g"
            ]
        },

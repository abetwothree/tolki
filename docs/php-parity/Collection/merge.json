            "label": "C32-F-merge-null-is-a-new-instance",
            "php": "$a = collect([1]); $b = $a->merge(null); $b->push(2);",
            "value": {
                "same": false,
                "receiver": [
                    1
                ],
                "result": [
                    1,
                    2
                ]
            }
        },
        {
            "label": "C32-F-merge-null-renumbers",
            "php": "collect([5 => 'a', 'k' => 'b'])->merge(null)",

    "probes": [
        {
            "label": "X5 unshift mutates and renumbers integer keys",
            "php": "collect([10,20,30,40])->unshift(1,2)",
            "value": [
                1,
                2,
                10,
                20,
                30,
                40
            ]
        },
        {
            "label": "unshift via Collection",
            "php": "collect([10,20,30,40])->unshift(1,2)",
            "value": [
                1,
                2,
                10,
                20,
                30,
                40
            ]
        },
        {
            "label": "D1 unshift assoc item onto assoc",
            "php": "$c = new Collection(['b' => 2]); $c->unshift(['a' => 1]); $c->all()",
            "value": {
                "0": {
                    "a": 1
                },
                "b": 2
            }
        },
        {
            "label": "D1b unshift two assoc items onto assoc",
            "php": "$c = new Collection(['b' => 2]); $c->unshift(['a' => 1], ['d' => 'house']); $c->all()",
            "value": {
                "0": {
                    "a": 1
                },
                "1": {
                    "d": "house"
                },
                "b": 2
            }
        },
        {
            "label": "D1c testUnshiftWithOneItem sequence on assoc",
            "php": "$c = new Collection(['x' => 4]); $c->unshift(['a', 'b', 'c']); $c->unshift(['who' => 'Jonny', 'preposition' => 'from', 'where' => 'Laroe']); $c->unshift('Jonny from Laroe')->toArray()",
            "value": {
                "0": "Jonny from Laroe",
                "1": {
                    "who": "Jonny",
                    "preposition": "from",
                    "where": "Laroe"
                },
                "2": [
                    "a",
                    "b",
                    "c"
                ],
                "x": 4
            }
        },
        {
            "label": "D1d unshift spread string-keyed",
            "php": "$c = new Collection(['b' => 2]); $c->unshift(...['a' => 1]); $c->all()",
            "threw": "ArgumentCountError",
            "message": "array_unshift() does not accept unknown named parameters"
        },
        {
            "label": "D1e unshift int-keyed item overlapping",

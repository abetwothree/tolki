{
    "meta": {
        "php": "8.5.9",
        "laravel": "v13.35.0-45-g01ac36d93a"
    },
    "probes": [
        {
            "label": "Collection::union",
            "php": "$c->union([\"a\"=>1,\"b\"=>2])",
            "value": {
                "a": null,
                "b": 2
            }
        },
        {
            "label": "X20 union lets the left operand win, null value included",
            "php": "['a'=>null] + ['a'=>1]",
            "value": {
                "nullWins": {
                    "a": null
                },
                "ints": [
                    10,
                    20,
                    50,
                    60
                ]
            }
        },
        {
            "label": "union treats null as an empty operand",
            "php": "collect([10,20])->union(null)",
            "value": [
                10,
                20
            ]
        },
        {
            "label": "C17 union array",
            "php": "(new Collection(['name' => 'Hello']))->union(['id' => 1])->all()",
            "value": {
                "name": "Hello",
                "id": 1
            }
        },
        {
            "label": "C18 union collection",
            "php": "(new Collection(['name' => 'Hello']))->union(new Collection(['name' => 'World', 'id' => 1]))->all()",
            "value": {
                "name": "Hello",
                "id": 1
            }
        },
        {
            "label": "union-list-operand",
            "php": "(new Collection(['a' => 1]))->union([5])",
            "value": {
                "a": 1,
                "0": 5
            }
        },
        {
            "label": "union-list-keyed-operand",
            "php": "(new Collection([1, 2]))->union([2 => 'z']), (new Collection([1]))->union([3 => 'd'])->union([9, 8, 7, 6])->sortKeys(), (new Collection([1]))->union([3 => 'd']), (new Collection([1, 2]))->union(['a' => 5])",
            "value": {
                "offset": [
                    1,
                    2,
                    "z"
                ],
                "gap-filled": [
                    1,
                    8,
                    7,
                    "d"
                ],
                "gap": {
                    "0": 1,
                    "3": "d"
                },
                "string-key": {
                    "0": 1,
                    "1": 2,
                    "a": 5
                }
            }
        },
        {
            "label": "list-backing-keyed-operand",
            "php": "(new Collection(['a', 'b']))->union([2 => 'z']) and (new Collection(['a', 'b', 'c']))->intersectByKeys([0 => 'x', 2 => 'y'])",
            "value": {
                "union": [
                    "a",
                    "b",
                    "z"
                ],
                "intersectByKeys": [
                    "a",
                    "c"
                ]
            }
        },
        {
            "label": "union-all-nullish",
            "php": "(new Collection(null))->union(null)",
            "value": []
        },
        {
            "label": "union-list-backing-keyed-result",
            "php": "(new Collection())->union(['a' => 1]), (new Collection([1, 2]))->union(['a' => 1, 5 => 9]), ([1, 2])->union([-1 => 9]), ([1])->union([3 => 4]), ([1])->union([3 => 4])->union([9, 8, 7, 6])",
            "value": {
                "empty-string-key": {
                    "a": 1
                },
                "string-key-and-gap": {
                    "0": 1,
                    "1": 2,
                    "a": 1,
                    "5": 9
                },
                "negative-key": {
                    "0": 1,
                    "1": 2,
                    "-1": 9
                },
                "gap": {
                    "0": 1,
                    "3": 4
                },
                "gap-then-filled": {
                    "0": 1,
                    "3": 4,
                    "1": 8,
                    "2": 7
                }
            }
        },
        {
            "label": "union-function-valued-member",
            "php": "(new Collection(['all' => $fn, 'admin' => 'a']))->union(['guest' => 1]), (['toJSON' => fn () => 'J', 'b' => 2])->union(['c' => 3]), (['toArray' => fn () => [9], 'b' => 2])->union(['c' => 3]): the keys, and how often $fn ran",

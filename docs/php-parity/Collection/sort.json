                        "id": "q"
                    }
                ]
            ]
        },
        {
            "label": "C32-G-sort-comparator-int-cast",
            "php": "(new Collection([3, 1, 2]))->sort($comparator)->values()->all() for a comparator answering a fraction below 1, an infinity and NAN, which uasort() casts to 0",
            "value": {
                "fraction": [

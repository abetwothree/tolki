                {
                    "n": 2
                },
                {
                    "n": 3
                }
            ]
        },
        {
            "label": "C32-G-sort-comparator-out-of-order",
            "php": "(new Collection([2 => ['n' => 1, 'id' => 'p'], 0 => ['n' => 1, 'id' => 'q'], 1 => ['n' => 0, 'id' => 'r']]))->sort(fn ($a, $b) => $a['n'] <=> $b['n'])",

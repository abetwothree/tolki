{
    "meta": {
        "php": "8.5.9",
        "laravel": "v13.35.0-45-g01ac36d93a"
    },
    "probes": [
        {
            "label": "sort/sortDesc/reverse preserve integer keys and their order",
            "php": "asort/arsort/array_reverse on [0=>3,1=>1,2=>2]",
            "value": {
                "sort_all": {
                    "1": 1,
                    "2": 2,
                    "0": 3
                },
                "sort_values": [
                    1,
                    2,
                    3
                ],
                "sortdesc_all": {
                    "0": 3,
                    "2": 2,
                    "1": 1
                },
                "sortdesc_values": [
                    3,
                    2,
                    1
                ],
                "reverse_all": {
                    "2": 2,
                    "1": 1,
                    "0": 3
                },
                "reverse_values": [
                    2,
                    1,
                    3
                ]
            }
        },
        {
            "label": "Collection::sort \u2014 a string callback is a sort flag, not a field path",
            "php": "sort(\"\"), sort(\"0\"), sort(\"age\")",
            "value": {
                "empty_string": {
                    "threw": "TypeError",
                    "message": "asort(): Argument #2 ($flags) must be of type int, string given"
                },
                "zero_string": {
                    "b": 1,
                    "c": 2,
                    "a": 3
                },
                "non_callable_string": {
                    "threw": "TypeError",
                    "message": "asort(): Argument #2 ($flags) must be of type int, string given"
                },
                "is_callable_age": false
            }
        },
        {
            "label": "Collection::sort orders numeric strings numerically",
            "php": "collect([\"9\",\"10\",\"1\",5])->sort()->values()",
            "value": [
                "1",
                5,
                "9",
                "10"
            ]
        },
        {
            "label": "order-sort",
            "php": "collect(base)->sort()",
            "value": {
                "all": [
                    "a",
                    "b",
                    "c"
                ],
                "values": [
                    "a",
                    "b",
                    "c"
                ],
                "keys": [
                    0,
                    1,
                    2
                ]
            }
        },
        {
            "label": "order-sort-does-not-mutate",
            "php": "$c = collect(base); $c->sort(); $c",
            "value": {
                "all": {
                    "2": "c",
                    "0": "a",
                    "1": "b"
                },
                "values": [
                    "c",
                    "a",
                    "b"
                ],
                "keys": [
                    2,
                    0,
                    1
                ]
            }
        },
        {
            "label": "C32-G-sort-comparator",
            "php": "(new Collection([5, 3, 1, 2, 4]))->sort(fn ($a, $b) => $a <=> $b)->values()->all()",
            "value": [
                1,
                2,
                3,
                4,
                5
            ]
        },
        {
            "label": "C32-G-sort-comparator-desc",
            "php": "(new Collection([5, 3, 1, 2, 4]))->sort(fn ($a, $b) => $b <=> $a)->values()->all()",
            "value": [
                5,
                4,
                3,
                2,
                1
            ]
        },
        {
            "label": "C32-G-sort-comparator-assoc",
            "php": "(new Collection(['a' => 3, 'b' => 1, 'c' => 2]))->sort(fn ($x, $y) => $x <=> $y)->all()",
            "value": [
                [
                    "b",
                    1
                ],

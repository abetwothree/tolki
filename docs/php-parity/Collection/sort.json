                    3
                ]
            ]
        },
        {
            "label": "C32-G-sort-comparator-rows",
            "php": "(new Collection([['n' => 2], ['n' => 1], ['n' => 3]]))->sort(fn ($a, $b) => $a['n'] <=> $b['n'])->values()->all()",
            "value": [
                {
                    "n": 1

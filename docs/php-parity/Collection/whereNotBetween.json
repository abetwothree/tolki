            "label": "whereNotBetween over numeric strings and falsy values",
            "php": "collect($between)->whereNotBetween(\"v\",[\"1\",\"5\"])->pluck(\"v\")",
            "value": [
                "9",
                "10",
                null,
                0
            ]
        },
        {
            "label": "C32-D-whereNotBetween-collection-values",
            "php": "whereNotBetween('v', new Collection([1, 3])) over v = 0..4",
            "value": [
                0,
                4
            ]
        },
        {
            "label": "whereNotBetween-list-gap-keys",

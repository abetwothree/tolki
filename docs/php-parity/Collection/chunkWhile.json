    "probes": [
        {
            "label": "chunkWhile on equal adjacent elements",
            "php": "['A','A','B','B','C','C','C'] chunkWhile(last === current)",
            "value": [
                [
                    "A",
                    "A"
                ],
                {
                    "2": "B",
                    "3": "B"
                },
                {
                    "4": "C",
                    "5": "C",
                    "6": "C"
                }
            ]
        },
        {
            "label": "chunkWhile on contiguously increasing integers",
            "php": "[1,4,9,10,11,12,15,16,19,20,21] chunkWhile(last + 1 == current)",

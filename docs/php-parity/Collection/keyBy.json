{
    "meta": {
        "php": "8.5.9",
        "laravel": "v13.35.0-45-g01ac36d93a"
    },
    "probes": [
        {
            "label": "collection-keyBy-scalar-key-cast",
            "php": "(new Collection(['a' => ['k' => true], 'b' => ['k' => false], 'c' => ['k' => null]]))->keyBy('k') and @(new Collection([['v' => 1]]))->keyBy(fn () => 2.5): the keys",
            "value": {
                "field": [
                    1,
                    0,
                    ""
                ],
                "float": [
                    2
                ]
            }
        },
        {
            "label": "C32-E-keyBy-int-key-order",
            "php": "collect([['id'=>3],['id'=>1],['id'=>2]])->keyBy('id')->keys()",
            "value": [
                3,
                1,
                2
            ]
        },
        {
            "label": "C32-E-keyBy-enum-keys",
            "php": "keyBy over int-backed B then A, and keyBy(fn => pure A)",
            "value": {
                "int": [
                    [
                        2,
                        "integer",
                        1
                    ],
                    [
                        1,
                        "integer",
                        2
                    ]
                ],
                "pure": [
                    "A"
                ]
            }
        },
        {
            "label": "C32-E-keyBy-stringable-keys",
            "php": "keyBy(fn => object with __toString) and keyBy(fn => new Stringable('Lara'))",
            "value": {
                "toString": [
                    "Framework"
                ],
                "stringable": [
                    "Lara"
                ]
            }
        },
        {
            "label": "C32-E-keyBy-callback-key-type",
            "php": "collect([1 => 'a', 'x' => 'b'])->keyBy(fn ($v, $k) => $v.':'.gettype($k))->keys()",
            "value": [
                "a:integer",
                "b:string"
            ]
        },
        {
            "label": "C32-E-keyBy-array-path",
            "php": "collect([['a'=>['b'=>'z']]])->keyBy(['a','b']) and collect([['id'=>1,'name'=>'John']])->keyBy(['id','name'])",
            "value": {
                "nested": [
                    "z"
                ],
                "jsdoc": [
                    ""
                ]
            }
        },
        {
            "label": "C32-E-keyBy-collection-rows",
            "php": "c32c_rows(list | keyed)->keyBy('k'): each row's 'v'",
            "value": {
                "list": {
                    "b": 3,
                    "a": 2
                },
                "keyed": {
                    "b": 3,
                    "a": 2
                }
            }
        },
        {
            "label": "C32-E-keyBy-array-key",
            "php": "(new Collection([1]))->keyBy(fn () => [1, 2])",
            "threw": "TypeError",
            "message": "Cannot access offset of type array on array"
        },
        {
            "label": "C32-E-keyBy-assoc-key",
            "php": "(new Collection([1]))->keyBy(fn () => ['a' => 1])",
            "threw": "TypeError",
            "message": "Cannot access offset of type array on array"
        },
        {
            "label": "C32-E-keyBy-date-key",
            "php": "(new Collection([1]))->keyBy(fn () => new DateTime('@0'))",
            "threw": "Error",
            "message": "Object of class DateTime could not be converted to string"
        }
    ]
}

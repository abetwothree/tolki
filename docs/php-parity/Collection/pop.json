    "probes": [
        {
            "label": "pop() on an assoc collection",
            "php": "(new Collection([\"x\"=>1,\"y\"=>2,\"z\"=>3]))->pop()",
            "value": {
                "returned": 3,
                "remaining": {
                    "x": 1,
                    "y": 2
                }
            }
        },
        {
            "label": "pop(2) \u2014 reverse order, source keys kept",
            "php": "(new Collection([...]))->pop(2)",
            "value": {
                "returned": [
                    3,
                    2
                ],
                "remaining": {
                    "x": 1
                }
            }
        },
        {
            "label": "pop(0) \u2014 count < 1",
            "php": "(new Collection([\"x\"=>1]))->pop(0)",
            "value": {
                "returned": [],
                "remaining": {
                    "x": 1
                }
            }
        },
        {
            "label": "X1 pop mutates and returns the last value",
            "php": "collect([10,20,30,40])->pop()",
            "value": {
                "pop": 40,
                "after": [
                    10,
                    20,
                    30
                ],
                "pop2": [
                    40,
                    30
                ],
                "after2": [
                    10,
                    20
                ]
            }
        },
        {
            "label": "D8 pop(2) on assoc returns list",
            "php": "$c = new Collection(['a' => 1, 'b' => 2, 'c' => 3]); ['returned' => $c->pop(2)->all(), 'remaining' => $c->all()]",
            "value": {
                "returned": [
                    3,
                    2
                ],
                "remaining": {
                    "a": 1
                }
            }
        },
        {
            "label": "P1 pop on assoc",
            "php": "$c = new Collection(['foo' => 'f', 'bar' => 'b']); ['popped' => $c->pop(), 'first' => $c->first(), 'all' => $c->all()]",
            "value": {

{
    "meta": {
        "php": "8.5.9",
        "laravel": "v13.35.0-45-g01ac36d93a"
    },
    "probes": [
        {
            "label": "Collection::sortBy \u2014 string \"desc\" direction sorts descending",
            "php": "sortBy([[\"age\",\"desc\"]])",
            "value": [
                {
                    "age": 10
                },
                {
                    "age": 2
                }
            ]
        },
        {
            "label": "Collection::sortBy \u2014 unrecognized direction sorts descending (default arm)",
            "php": "sortBy([[\"age\",\"BOGUS\"]])",
            "value": [
                {
                    "age": 10
                },
                {
                    "age": 2
                }
            ]
        },
        {
            "label": "Collection::sortBy \u2014 global $descending=true is ignored for the array-of-descriptors form",
            "php": "sortBy([[\"age\"]], SORT_REGULAR, true)",
            "value": [
                {
                    "age": 2
                },
                {
                    "age": 10
                }
            ]
        },
        {
            "label": "sortBy/sortByDesc: all() and values() agree on order",
            "php": "sortBy/sortByDesc over [0=>3,1=>1,2=>2]",
            "value": {
                "sortby_all": {
                    "1": {
                        "v": 1
                    },
                    "2": {
                        "v": 2
                    },
                    "0": {
                        "v": 3
                    }
                },
                "sortby_values": [
                    {
                        "v": 1
                    },
                    {
                        "v": 2
                    },
                    {
                        "v": 3
                    }
                ],
                "sortbydesc_all": {
                    "0": {
                        "v": 3
                    },
                    "2": {
                        "v": 2
                    },
                    "1": {
                        "v": 1
                    }
                },
                "sortbydesc_values": [
                    {
                        "v": 3
                    },
                    {
                        "v": 2
                    },
                    {
                        "v": 1
                    }
                ],
                "sortbymany_values": [
                    {
                        "v": 1
                    },
                    {
                        "v": 2
                    },
                    {
                        "v": 3
                    }
                ]
            }
        },
        {
            "label": "sortBy/sortByMany over an integer-keyed backing",
            "php": "sortBy(fn), sortBy([[key]]), sortBy([comparator])",
            "value": {
                "words_all": {
                    "1": "dayle",
                    "0": "taylor"
                },
                "words_values": [
                    "dayle",
                    "taylor"
                ],
                "records_all": {
                    "1": {
                        "sort": 1
                    },
                    "0": {
                        "sort": 2
                    }
                },
                "records_values": [
                    {
                        "sort": 1
                    },
                    {
                        "sort": 2
                    }
                ],
                "imgs_plucked": [
                    "img1",
                    "img10",
                    "img101",
                    "img11"
                ],
                "vals_plucked": [
                    5,
                    10,
                    20
                ],
                "nums_all": {
                    "1": 1,
                    "2": 2,
                    "0": 3
                },
                "nums_values": [
                    1,
                    2,
                    3
                ]
            }
        },
        {
            "label": "sortBy with no comparisons leaves the order alone",
            "php": "collect([3,1,2])->sortBy([])",
            "value": [
                3,
                1,
                2
            ]
        },
        {
            "label": "sortBy(null) over array values",
            "php": "collect([\"a\"=>[\"n\"=>2],\"b\"=>[\"n\"=>1],\"c\"=>[\"n\"=>3]])->sortBy(null)->values()",
            "value": [
                {
                    "n": 1
                },
                {
                    "n": 2
                },
                {
                    "n": 3
                }
            ]
        },
        {
            "label": "sortByMany falls through on an equal first key",
            "php": "collect([[\"a\"=>[],\"b\"=>2],[\"a\"=>[],\"b\"=>1]])->sortBy([[\"a\",\"asc\"],[\"b\",\"asc\"]])->values()",
            "value": [
                {
                    "a": [],
                    "b": 1
                },
                {
                    "a": [],
                    "b": 2
                }
            ]
        },
        {
            "label": "sortByMany treats 1 and \"1\" as a tie",
            "php": "collect([[\"a\"=>1,\"b\"=>2],[\"a\"=>\"1\",\"b\"=>1]])->sortBy([[\"a\",\"asc\"],[\"b\",\"asc\"]])->values()",
            "value": [
                {
                    "a": "1",
                    "b": 1
                },
                {
                    "a": 1,
                    "b": 2
                }
            ]
        },
        {
            "label": "sortByMany orders mixed numeric strings and ints numerically",
            "php": "collect($mixed)->sortBy([\"item\"])->pluck(\"item\")",
            "value": [
                "1",
                5,
                "10",
                20
            ]
        },
        {
            "label": "sortBy runs a comparator nested in a one-element descriptor",
            "php": "collect($rows)->sortBy([[$byAge]])->values()",
            "value": [
                {
                    "age": 1
                },
                {
                    "age": 2
                },
                {
                    "age": 3
                }
            ]
        },
        {
            "label": "sortBy treats [[fn]] and [fn] the same",
            "php": "collect($rows)->sortBy([$byAge])->values()",
            "value": [
                {
                    "age": 1
                },
                {
                    "age": 2
                },
                {
                    "age": 3
                }
            ]
        },
        {
            "label": "Collection::sortBy(null) orders numeric strings numerically",
            "php": "collect([\"9\",\"10\",\"1\",5])->sortBy(null)->values()",
            "value": [
                "1",
                5,
                "9",
                "10"
            ]
        },
        {
            "label": "Collection::sortBy([key]) orders numeric strings numerically",
            "php": "collect($rows)->sortBy([\"n\"])->pluck(\"n\")",
            "value": [
                "1",
                5,
                "9",
                "10"
            ]
        },
        {
            "label": "sortBy-many-numeric-flag-asc",
            "php": "sortBy([['price', 'asc']], SORT_NUMERIC)->pluck('price')->values()",
            "value": [

    "probes": [
        {
            "label": "collapseWithKeys-string-keys",
            "php": "(new Collection(['first' => ['a' => 1, 'b' => 2], 'second' => ['c' => 3]]))->collapseWithKeys()",
            "value": [
                [
                    "a",
                    1
                ],
                [
                    "b",
                    2
                ],
                [
                    "c",
                    3
                ]
            ]
        },
        {
            "label": "collapseWithKeys-mixed-keys",
            "php": "(new Collection([5 => ['a' => 1], 'second' => new Collection(['b' => 2, 'a' => 3])]))->collapseWithKeys()",
            "value": [
                [
                    "a",
                    3
                ],
                [
                    "b",
                    2
                ]
            ]
        },
        {
            "label": "collapseWithKeys-string-keys-lists",
            "php": "(new Collection(['first' => [1, 2], 'second' => [3]]))->collapseWithKeys()",
            "value": [
                3,
                2
            ]
        },
        {
            "label": "C32-E-collapseWithKeys-int-key-order",
            "php": "collect([[1=>'a'],[3=>'c'],[2=>'b'],'drop'])->collapseWithKeys()",

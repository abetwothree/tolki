{
    "meta": {
        "php": "8.5.9",
        "laravel": "v13.35.0-45-g01ac36d93a"
    },
    "probes": [
        {
            "label": "X19 combine on matching counts",
            "php": "collect(['a','b','c'])->combine([1,2,3])",
            "value": {
                "a": 1,
                "b": 2,
                "c": 3
            }
        },
        {
            "label": "C10 combine list keys, offset values",
            "php": "(new Collection(['name', 'family']))->combine([1 => 'taylor', 2 => 'otwell'])->toArray()",
            "value": {
                "name": "taylor",
                "family": "otwell"
            }
        },
        {
            "label": "C11 combine offset keys, list values",
            "php": "(new Collection([1 => 'name', 2 => 'family']))->combine(['taylor', 'otwell'])->toArray()",
            "value": {
                "name": "taylor",
                "family": "otwell"
            }
        },
        {
            "label": "C12 combine offset both",
            "php": "(new Collection([1 => 'name', 2 => 'family']))->combine([2 => 'taylor', 3 => 'otwell'])->toArray()",
            "value": {
                "name": "taylor",
                "family": "otwell"
            }
        },
        {
            "label": "C13 combine lists -> int keys",
            "php": "(new Collection([1, 2, 3]))->combine([4, 5, 6])->toArray()",
            "value": {
                "1": 4,
                "2": 5,
                "3": 6
            }
        },
        {
            "label": "D5 combine null/bool/float keys",
            "php": "(new Collection(['k' => null|true|false|1.5|'7']))->combine([1])->all(), keyed 'null','true','false','float','numstr'",
            "value": {
                "null": {
                    "": 1
                },
                "true": {
                    "1": 1
                },
                "false": {
                    "": 1
                },
                "float": {
                    "1.5": 1
                },
                "numstr": {
                    "7": 1
                }
            }
        },
        {
            "label": "combine-float-keys",
            "php": "@(new Collection([INF, -INF, NAN, -0.0, 1.5, -1.5, 1e21, 1.5e300, 1.5e-7, 0.00001, 0.0001, 0.1 + 0.2, 1 / 3, 10000000000000.5, 10000000000001.5, 5e-324, 99999999999999.98]))->combine(range(1, 17)): the keys",
            "value": [
                "INF",
                "-INF",
                "NAN",
                "-0",
                "1.5",
                "-1.5",
                "1.0E+21",
                "1.5E+300",
                "1.5E-7",
                "1.0E-5",
                "0.0001",
                "0.3",
                "0.33333333333333",
                10000000000000,
                10000000000002,
                "4.9406564584125E-324",
                "1.0E+14"
            ]
        },
        {
            "label": "combine-large-int-key",
            "php": "(new Collection([4611686018427387904, -7]))->combine([1, 2]): each key as [type, string]",
            "value": [
                [
                    "integer",
                    "4611686018427387904"
                ],
                [
                    "integer",
                    "-7"
                ]
            ]
        },
        {
            "label": "combine-list-keyed-values",
            "php": "(new Collection([1, 2]))->combine(['a' => 'x', 'b' => 'y']) and ->combine(new Collection(['a' => 'x', 'b' => 'y']))",
            "value": {
                "keyed": {
                    "1": "x",
                    "2": "y"
                },
                "collection": {
                    "1": "x",
                    "2": "y"
                }
            }
        },
        {
            "label": "combine-collection-values",
            "php": "(new Collection(['a', 'b']))->combine(new Collection(['x', 'y']))",
            "value": {

    "probes": [
        {
            "label": "append-key-past-the-highest-integer-key",
            "php": "$c = collect([5 => 'a']); $c->add('z')",
            "value": {
                "all": {
                    "5": "a",
                    "6": "z"
                },
                "values": [
                    "a",
                    "z"
                ],
                "keys": [
                    5,
                    6
                ]
            }
        },
        {
            "label": "append-key-skips-an-occupied-slot",

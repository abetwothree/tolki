[
    {
        "label": "replace does not mutate",
        "php": "$c->replace([\"b\"=>2])",
        "value": {
            "result": {
                "a": 1,
                "b": 2
            },
            "source": {
                "a": 1
            }
        }
    },
    {
        "label": "replace(null)",
        "php": "$c->replace(null)",
        "value": {
            "a": 1,
            "b": 2,
            "c": 3
        }
    },
    {
        "label": "replaceRecursive nested",
        "php": "$c->replaceRecursive([\"a\"=>[\"y\"=>2]])",
        "value": {
            "result": {
                "a": {
                    "x": 1,
                    "y": 2
                }
            },
            "source": {
                "a": {
                    "x": 1
                }
            }
        }
    },
    {
        "label": "replaceRecursive(null)",
        "php": "$c->replaceRecursive(null)",
        "value": {
            "a": 1
        }
    },
    {
        "label": "replace array does not mutate",
        "php": "$c->replace([9])",
        "value": {
            "result": [
                9,
                2
            ],
            "source": [
                1,
                2
            ]
        }
    },
    {
        "label": "replace array (null)",
        "php": "$c->replace(null)",
        "value": [
            1,
            2,
            3
        ]
    },
    {
        "label": "replaceRecursive array nested",
        "php": "$c->replaceRecursive([[\"y\"=>2]])",
        "value": {
            "result": [
                {
                    "x": 1,
                    "y": 2
                },
                2
            ],
            "source": [
                {
                    "x": 1
                },
                2
            ]
        }
    },
    {
        "label": "replaceRecursive array (null)",
        "php": "$c->replaceRecursive(null)",
        "value": [
            1
        ]
    }
]

{
    "meta": {
        "php": "8.5.9",
        "laravel": "v13.25.0-10-g0015ce4753"
    },
    "probes": [
        {
            "label": "Arr::query with booleans",
            "php": "Arr::query([\"foo\"=>\"bar\",\"bar\"=>true])",
            "value": {
                "true": "foo=bar&bar=1",
                "false": "foo=bar&bar=0",
                "empty": "foo=bar&bar=",
                "null": "foo=bar",
                "none": ""
            }
        },
        {
            "label": "Arr::toCssClasses mixed keys",
            "php": "Arr::toCssClasses([...])",
            "value": "font-bold mt-4 ml-2"
        },
        {
            "label": "Arr::toCssStyles mixed keys",
            "php": "Arr::toCssStyles([...])",
            "value": "font-weight: bold; margin-top: 4px; margin-left: 2px;"
        },
        {
            "label": "Arr::random on empty",
            "php": "Arr::random([])",
            "threw": "InvalidArgumentException",
            "message": "You requested 1 items, but there are only 0 items available."
        },
        {
            "label": "Arr::random preserveKeys default",
            "php": "Arr::random([...], 2)",
            "value": [
                0,
                1
            ]
        },
        {
            "label": "Arr::only with a bare string key",
            "php": "Arr::only([\"foo\"=>1,\"bar\"=>\"baz\"], \"bar\")",
            "value": {
                "bar": "baz"
            }
        },
        {
            "label": "Arr::flatten default depth",
            "php": "Arr::flatten([\"a\"=>[\"b\"=>[\"c\"=>[\"d\"=>1]]]])",
            "value": [
                1
            ]
        },
        {
            "label": "Arr::mapWithKeys numeric-like keys",
            "php": "Arr::mapWithKeys([...])",
            "value": {
                "1": 1,
                "2": 2
            }
        },
        {
            "label": "Arr::toCssClasses with is_numeric edge-case keys",
            "php": "Arr::toCssClasses(['' => 'foo', ' ' => 'foo', '0x10' => 'foo', '1e3' => 'foo', 'Infinity' => 'foo'])",
            "value": {
                "empty": "",
                "space": " ",
                "hex": "0x10",
                "sci": "foo",
                "infinity": "Infinity"
            }
        },

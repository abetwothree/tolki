[
    {
        "label": "flatten depth 0 fully flattens (depth never hits 1)",
        "php": "Arr::flatten([1,[2,[3]]], 0)",
        "value": [
            1,
            2,
            3
        ]
    },
    {
        "label": "flatten depth 0 via Collection",
        "php": "collect([1,[2,[3]]])->flatten(0)->all()",
        "value": [
            1,
            2,
            3
        ]
    },
    {
        "label": "flatten depth 1 for comparison",
        "php": "collect([1,[2,[3]]])->flatten(1)->all()",
        "value": [
            1,
            2,
            [
                3
            ]
        ]
    },
    {
        "label": "sortDesc ties fall back to original order, not a full reverse",
        "php": "collect([[id=a,k=2],[id=b,k=1],[id=c,k=2],[id=d,k=3]])->sortByDesc(fn($i)=>$i[\"k\"])->pluck(\"id\")->values()->all()",
        "value": [
            "d",
            "a",
            "c",
            "b"
        ]
    },
    {
        "label": "sortDesc on integer-keyed collection reorders values (PHP)",
        "php": "collect([0=>3,1=>1,2=>2])->sortDesc()->all()",
        "value": {
            "0": 3,
            "2": 2,
            "1": 1
        }
    },
    {
        "label": "PHP casts \"-1\" to int(-1) and array_splice renumbers it too (JS does not)",
        "php": "array_splice($a=['-1'=>'x','b'=>'y','c'=>'z'], 1, 1)",
        "value": {
            "0": "x",
            "c": "z"
        }
    }
]

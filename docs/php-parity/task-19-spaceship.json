        },
        {
            "label": "Arr::sort orders numeric strings numerically",
            "php": "Arr::sort([\"9\",\"10\",\"1\",5])",
            "value": [
                "1",
                5,
                "9",
                "10"
            ]
        },
        {
            "label": "Arr::sortDesc orders numeric strings numerically",
            "php": "Arr::sortDesc([\"9\",\"10\",\"1\",5])",
            "value": [
                "10",
                "9",
                5,
                "1"
            ]
        },
        {
            "label": "Collection::sort orders numeric strings numerically",
            "php": "collect([\"9\",\"10\",\"1\",5])->sort()->values()",
            "value": [
                "1",
                5,
                "9",
                "10"
            ]
        },
        {
            "label": "Collection::sortDesc orders numeric strings numerically",
            "php": "collect([\"9\",\"10\",\"1\",5])->sortDesc()->values()",
            "value": [
                "10",
                "9",
                5,
                "1"
            ]
        },
        {
            "label": "Collection::sortBy(null) orders numeric strings numerically",
            "php": "collect([\"9\",\"10\",\"1\",5])->sortBy(null)->values()",
            "value": [
                "1",
                5,
                "9",
                "10"
            ]
        },
        {
            "label": "Collection::sortByDesc(null) orders numeric strings numerically",
            "php": "collect([\"9\",\"10\",\"1\",5])->sortByDesc(null)->values()",
            "value": [
                "10",
                "9",
                5,
                "1"
            ]
        },
        {
            "label": "Arr::sort by key orders numeric strings numerically",
            "php": "Arr::sort($rows, \"n\")",
            "value": [
                {
                    "n": "1"
                },
                {
                    "n": 5
                },
                {
                    "n": "9"
                },
                {
                    "n": "10"
                }
            ]
        },
        {
            "label": "Collection::sortBy([key]) orders numeric strings numerically",
            "php": "collect($rows)->sortBy([\"n\"])->pluck(\"n\")",
            "value": [
                "1",
                5,
                "9",
                "10"
            ]
        },
        {
            "label": "asort ties zero and null, keeping insertion order",
            "php": "asort([\"user1\"=>0,\"user2\"=>null,\"user3\"=>25])",
            "value": [
                "user1",
                "user2",
                "user3"
            ]
        },
        {
            "label": "asort ties null and an empty array, keeping insertion order",
            "php": "asort([\"user2\"=>null,\"user4\"=>[],...])",
            "value": [
                "user2",
                "user3",
                "user1",
                "user0",
                "user4"
            ]
        },
        {
            "label": "arsort over the same null and empty-array fixture",
            "php": "arsort([\"user2\"=>null,\"user4\"=>[],...])",
            "value": [
                "user0",
                "user1",
                "user3",
                "user2",
                "user4"
            ]
        }
    ]

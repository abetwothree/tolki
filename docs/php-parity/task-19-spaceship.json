    "probes": [
        {
            "label": "spaceship on two numeric strings, wider on the left",
            "php": "\"10\" <=> \"9\"",
            "value": 1
        },
        {
            "label": "spaceship on numeric strings spelled differently",
            "php": "\"1\" <=> \"01\"",
            "value": 0
        },
        {
            "label": "spaceship on an int and its numeric string",
            "php": "1 <=> \"1\"",
            "value": 0
        },
        {
            "label": "spaceship on an int and a non-numeric string",
            "php": "5 <=> \"abc\"",
            "value": -1
        },
        {
            "label": "spaceship on a non-numeric string and an int",
            "php": "\"abc\" <=> 0",
            "value": 1
        },
        {
            "label": "spaceship on a negative int and an empty string",
            "php": "-1 <=> \"\"",
            "value": 1
        },
        {
            "label": "spaceship on null and a non-numeric string",
            "php": "null <=> \"abc\"",
            "value": -1
        },
        {
            "label": "spaceship on null and the string zero",
            "php": "null <=> \"0\"",
            "value": -1
        },
        {
            "label": "spaceship on null and a positive int",
            "php": "null <=> 5",
            "value": -1
        },
        {
            "label": "spaceship on null and an empty array",
            "php": "null <=> []",
            "value": 0
        },
        {
            "label": "spaceship on false and a non-numeric string",
            "php": "false <=> \"abc\"",

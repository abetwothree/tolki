                    "3": {
                        "parent": "b",
                        "name": "4"
                    }
                },
                {
                    "4": {
                        "parent": "a",
                        "name": "5"
                    }
                }
            ]
        },
        {
            "label": "chunkBy with a bare string key (assoc)",
            "php": "['p'=>['parent'=>'a'],'q'=>['parent'=>'a'],'r'=>['parent'=>'b']] chunkBy('parent')",
            "value": [
                {
                    "p": {
                        "parent": "a"

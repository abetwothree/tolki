    "probes": [
        {
            "label": "add-lines-group-item",
            "php": "t(['en' => ['g' => ['b' => 'B']]]); addLines(['g.a' => 'A'], 'en'); get('g.a')",
            "value": "A"
        },
        {
            "label": "add-lines-replaces-an-unloaded-group",
            "php": "addLines(['g.a' => 'A'], 'en'); get('g')",
            "value": {
                "a": "A"
            }
        },
        {
            "label": "add-lines-merges-into-a-loaded-group",
            "php": "t(['en' => ['g' => ['b' => 'B']]]); get('g.b'); addLines(['g.a' => 'A'], 'en'); get('g')",
            "value": {
                "b": "B",
                "a": "A"
            }
        },
        {
            "label": "add-lines-nested-item",
            "php": "addLines(['g.x.y' => 'deep'], 'en'); get('g.x.y')",
            "value": "deep"
        },
        {

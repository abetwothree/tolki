{
    "meta": {
        "php": "8.5.9",
        "laravel": "v13.36.0-32-g6d2eefbb14"
    },
    "probes": [
        {
            "label": "get-namespaced-list-item",
            "php": "t(T1)->get('foo::bar.qux', ['foo' => 'bar'])",
            "value": {
                "0": "tree bar",
                "1": "breeze bar",
                "beep": {
                    "rock": "tree bar"
                }
            }
        },
        {
            "label": "get-namespaced-line",
            "php": "t(T1)->get('foo::bar.baz', ['foo' => 'bar'])",
            "value": "breeze bar"
        },
        {
            "label": "get-namespaced-line-without-replacements",
            "php": "t(T1)->get('foo::bar.foo')",
            "value": "foo"
        },
        {
            "label": "get-whole-group-walks-replacements",
            "php": "t(T1)->get('foo::bar', ['foo' => 'bar'])",
            "value": {
                "foo": "foo",
                "baz": "breeze bar",
                "qux": {
                    "0": "tree bar",
                    "1": "breeze bar",
                    "beep": {
                        "rock": "tree bar"
                    }
                }
            }
        },
        {
            "label": "get-missing-namespaced-group-returns-key",
            "php": "t(T1)->get('foo::unknown', ['foo' => 'bar'])",
            "value": "foo::unknown"
        },
        {
            "label": "get-missing-namespaced-item-returns-key",
            "php": "t(T1)->get('foo::bar.unknown')",
            "value": "foo::bar.unknown"
        },
        {
            "label": "get-keeps-html",
            "php": "t(['en' => ['foo' => ['bar' => 'breeze <p>test</p>']]])->get('foo.bar')",
            "value": "breeze <p>test</p>"
        },
        {
            "label": "get-group-reads-fallback-locale",
            "php": "langTranslator(['lv' => ['foo::bar' => ['baz' => 'breeze :foo']]], 'en', 'lv')->get('foo::bar.baz', ['foo' => 'bar'])",
            "value": "breeze bar"
        },
        {
            "label": "get-global-group-line",
            "php": "t(['en' => ['foo' => ['bar' => 'breeze :foo']]])->get('foo.bar', ['foo' => 'bar'])",
            "value": "breeze bar"
        },
        {
            "label": "get-json-line",
            "php": "t(['en' => ['foo' => 'one']])->get('foo')",
            "value": "one"
        },
        {
            "label": "get-json-line-replaces",
            "php": "t(['en' => ['Hello' => 'Hola :name']])->get('Hello', ['name' => 'Ann'])",
            "value": "Hola Ann"
        },
        {
            "label": "get-json-miss-reads-group",

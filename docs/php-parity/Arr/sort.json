        },
        {
            "label": "sort orders falsy values by value, not by falsiness",
            "php": "asort([-1,0,5])",
            "value": {
                "natural": {
                    "a": -1,
                    "b": 0,
                    "c": 5
                },
                "arr_sort": [
                    -1,
                    0,
                    5
                ],
                "collection_sortby_null": {
                    "a": -1,
                    "b": 0,
                    "c": 5
                },
                "sortdesc_values": [
                    3,
                    2,
                    1
                ],
                "reverse_values": [
                    2,
                    1,
                    3
                ]
            }
        },
        {
            "label": "sort by a string field orders falsy field values by value",
            "php": "Arr::sort($u, \"n\")",

    "probes": [
        {
            "label": "Arr::sort multi-key",
            "php": "Arr::sort($u, [\"name\",\"age\",\"meta.key\"])",
            "value": [
                {
                    "name": "Apple",
                    "age": 10,
                    "meta": {
                        "key": 2
                    }
                },
                {
                    "name": "Item",
                    "age": 2,
                    "meta": {
                        "key": 1
                    }
                },
                {
                    "name": "Item",
                    "age": 10,
                    "meta": {
                        "key": 3
                    }
                }
            ]
        },
        {
            "label": "direction tuple [age,false] \u2014 descending",
            "php": "Arr::sort($u, [\"name\",[\"age\",false]])",
            "value": [
                {
                    "name": "Item",
                    "age": 10
                },
                {
                    "name": "Item",
                    "age": 2
                }
            ]
        },
        {
            "label": "direction tuple [age,true] \u2014 ascending",

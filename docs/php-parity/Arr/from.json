    "probes": [
        {
            "label": "from-stdclass",
            "php": "Arr::from((object)['foo'=>'bar'])",
            "value": {
                "foo": "bar"
            }
        },
        {
            "label": "from-true-key-collision",
            "php": "Arr::from([1 => 'a', true => 'b'])",
            "value": [
                [
                    1,
                    "b"
                ]
            ]
        },
        {
            "label": "C32-A-arr-from-scalar-throws",
            "php": "Arr::from(123)",

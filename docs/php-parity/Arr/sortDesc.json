    "probes": [
        {
            "label": "Arr::sortDesc numeric comparison",
            "php": "Arr::sortDesc([1,10,9])",
            "value": [
                10,
                9,
                1
            ]
        },
        {
            "label": "sortDesc overrides an explicit \"asc\" direction",
            "php": "Arr::sortDesc($u, [[\"age\",\"asc\"]])",
            "value": [
                {
                    "age": 10
                },
                {
                    "age": 2
                }
            ]
        },
        {
            "label": "Arr::sortDesc orders numeric strings numerically",
            "php": "Arr::sortDesc([\"9\",\"10\",\"1\",5])",
            "value": [
                "10",
                "9",
                5,
                "1"
            ]
        },
        {
            "label": "sortDesc-rows-natural",
            "php": "Arr::sortDesc(['a'=>['name'=>'Chair'],'b'=>['name'=>'Desk']])",
            "value": {
                "b": {
                    "name": "Desk"
                },
                "a": {
                    "name": "Chair"
                }
            }
        },
        {
            "label": "sortDesc-rows-natural-keys",

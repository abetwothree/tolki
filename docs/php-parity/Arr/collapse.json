                "1": 2
            }
        },
        {
            "label": "collapse-collection-items",
            "php": "Arr::collapse([new Collection([1, 2]), 5, new Collection([3])])",
            "value": [
                1,
                2,
                3
            ]
        },
        {
            "label": "collapse-out-of-order-lists",
            "php": "Arr::collapse([2 => ['c'], 0 => ['a'], 1 => ['b']])",

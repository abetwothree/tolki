            "value": [
                "taylor",
                "dayle"
            ]
        },
        {
            "label": "pluck-nested-user.1-by-user.0",
            "php": "Arr::pluck($nk, 'user.1', 'user.0')",
            "value": {
                "taylor": "otwell",
                "dayle": "rees"
            }
        },
        {
            "label": "pluck-nested-arr-1-by-0-str",
            "php": "Arr::pluck($nk, ['user', '1'], ['user', '0'])",
            "value": {
                "taylor": "otwell",
                "dayle": "rees"
            }
        },
        {
            "label": "pluck-wildcard-email",
            "php": "Arr::pluck($na, 'users.*.email')",
            "value": [
                [
                    "taylorotwell@gmail.com"
                ],
                [
                    null,
                    null
                ]
            ]
        },
        {
            "label": "pluck-obj-and-array-rows-name",
            "php": "Arr::pluck($ao, 'name')",
            "value": [
                "taylor",
                "dayle"
            ]
        },
        {
            "label": "pluck-obj-and-array-rows-email-by-name",
            "php": "Arr::pluck($ao, 'email', 'name')",
            "value": {
                "taylor": "foo",
                "dayle": "bar"
            }
        },
        {
            "label": "pluck-with-keys-null-assoc",
            "php": "Arr::pluck(['a'=>['name'=>'Taylor','role'=>'developer'],'b'=>['name'=>'Abigail','role'=>'developer']], null, 'name')",
            "value": {
                "Taylor": {
                    "name": "Taylor",
                    "role": "developer"
                },
                "Abigail": {
                    "name": "Abigail",
                    "role": "developer"
                }
            }
        },
        {
            "label": "pluck-out-of-order",
            "php": "Arr::pluck([2 => ['n' => 'c', 'k' => 'kc'], 0 => ['n' => 'a', 'k' => 'ka'], 1 => ['n' => 'b', 'k' => 'kb']], 'n')",
            "value": [
                "c",
                "a",
                "b"
            ]
        },
        {
            "label": "pluck-out-of-order-keyed",
            "php": "Arr::pluck([2 => ['n' => 'c', 'k' => 'kc'], 0 => ['n' => 'a', 'k' => 'ka'], 1 => ['n' => 'b', 'k' => 'kb']], 'n', 'k')",
            "value": [
                [
                    "kc",
                    "c"
                ],
                [
                    "ka",
                    "a"
                ],
                [
                    "kb",
                    "b"
                ]
            ]
        },
        {
            "label": "pluck-out-of-order-keyed-collision",
            "php": "Arr::pluck([2 => ['n' => 'c', 'k' => 'same'], 0 => ['n' => 'a', 'k' => 'same'], 1 => ['n' => 'b', 'k' => 'other']], 'n', 'k')",
            "value": [
                [
                    "same",
                    "a"
                ],
                [
                    "other",
                    "b"
                ]
            ]
        },
        {
            "label": "pluck-mixed",
            "php": "Arr::pluck(['x' => ['n' => 'X'], 0 => ['n' => 'Z'], 'y' => ['n' => 'Y']], 'n')",
            "value": [
                "X",
                "Z",
                "Y"
            ]
        },
        {
            "label": "pluck-collision",
            "php": "Arr::pluck([1 => ['n' => 'a'], 0 => ['n' => 'z'], '1' => ['n' => 'b']], 'n')",
            "value": [
                "b",
                "z"
            ]
        },
        {
            "label": "pluck-out-of-order-whole-items-keyed",
            "php": "Arr::pluck([2 => ['n' => 'c', 'k' => 'kc'], 0 => ['n' => 'a', 'k' => 'ka'], 1 => ['n' => 'b', 'k' => 'kb']], null, 'k')",
            "value": [
                [
                    "kc",
                    [
                        [
                            "n",
                            "c"
                        ],
                        [
                            "k",
                            "kc"
                        ]
                    ]
                ],
                [
                    "ka",
                    [
                        [
                            "n",
                            "a"
                        ],
                        [
                            "k",
                            "ka"
                        ]
                    ]
                ],
                [
                    "kb",
                    [
                        [
                            "n",
                            "b"
                        ],
                        [
                            "k",
                            "kb"
                        ]
                    ]
                ]
            ]
        },
        {
            "label": "pluck-out-of-order-callback-order",
            "php": "Arr::pluck([2 => ['n' => 'c', 'k' => 'kc'], 0 => ['n' => 'a', 'k' => 'ka'], 1 => ['n' => 'b', 'k' => 'kb']], fn ($item) => $item['n'], fn ($item) => $item['k']) => 'v:' . $item['n'] per value call, 'k:' . $item['n'] per key call",
            "value": [
                "v:c",
                "k:c",
                "v:a",
                "k:a",
                "v:b",
                "k:b"
            ]
        }
    ]
}

{
    "meta": {
        "php": "8.5.9",
        "laravel": "v13.35.0-45-g01ac36d93a"
    },
    "probes": [
        {
            "label": "Arr::pluck wildcard path",
            "php": "Arr::pluck($d, \"users.*.first\")",
            "value": [
                [
                    "taylor"
                ],
                [
                    "abigail",
                    "dayle"
                ]
            ]
        },
        {
            "label": "Arr::pluck wildcard + key",
            "php": "Arr::pluck($d, \"users.*.first\", \"account\")",
            "value": {
                "a": [
                    "taylor"
                ],
                "b": [
                    "abigail",
                    "dayle"
                ]
            }
        },
        {
            "label": "Arr::pluck array path",
            "php": "Arr::pluck($d, [\"developer\",\"name\"])",
            "value": [
                "Taylor",
                "Abigail"
            ]
        },
        {
            "label": "Arr::pluck null value keeps the item",
            "php": "Arr::pluck($d, null, \"name\")",
            "value": {
                "Taylor": {
                    "name": "Taylor",
                    "role": "dev"
                }
            }
        },
        {
            "label": "Arr::pluck missing path",
            "php": "Arr::pluck($d, \"foo\")",
            "value": [
                null,
                null
            ]
        },
        {
            "label": "Arr::pluck \u2014 missing key field vs explicit null key",
            "php": "Arr::pluck($u, \"name\", \"id\")",
            "value": {
                "": "Jane"
            }
        },
        {
            "label": "Arr::pluck wildcard over an associative (object-shaped) target, string-keyed outer",
            "php": "Arr::pluck([\"a\"=>$shape], \"meta.*.v\")",
            "value": [
                [
                    1,
                    2
                ]
            ]
        },
        {
            "label": "Arr::pluck wildcard over an associative (object-shaped) target, list outer",
            "php": "Arr::pluck([$shape], \"meta.*.v\")",
            "value": [
                [
                    1,
                    2
                ]
            ]
        },
        {
            "label": "Arr::pluck \u2014 boolean key casts to int, not string",
            "php": "Arr::pluck($u, \"name\", \"flag\")",
            "value": {
                "1": "X",
                "0": "Y"
            }
        },
        {
            "label": "pluck wildcard over a non-iterable",
            "php": "Arr::pluck([[\"meta\"=>\"x\"]], \"meta.*.v\")",
            "value": {
                "scalar_string": [
                    null
                ],
                "null": [
                    null
                ],
                "int": [
                    null
                ],
                "assoc_target": [
                    null
                ]
            }
        },
        {
            "label": "X27 pluck supports wildcard and array paths",
            "php": "Arr::pluck(...,'name')",
            "value": {
                "plain": [
                    "c",
                    "a",
                    "b"
                ],
                "keyed": {
                    "3": "c",
                    "1": "a",
                    "2": "b"
                },
                "wildcard": [
                    [
                        "p1",
                        "p2"
                    ]
                ]
            }
        },
        {
            "label": "pluck-comments",
            "php": "Arr::pluck($data, 'comments')",
            "value": [
                {
                    "tags": [
                        "#foo",
                        "#bar"
                    ]
                },
                {
                    "tags": [
                        "#baz"
                    ]
                }
            ]
        },
        {
            "label": "pluck-comments.tags",
            "php": "Arr::pluck($data, 'comments.tags')",
            "value": [
                [
                    "#foo",
                    "#bar"
                ],
                [
                    "#baz"
                ]
            ]
        },
        {
            "label": "pluck-foo",
            "php": "Arr::pluck($data, 'foo')",
            "value": [
                null,
                null
            ]
        },
        {
            "label": "pluck-foo.bar",
            "php": "Arr::pluck($data, 'foo.bar')",
            "value": [
                null,
                null
            ]
        },
        {
            "label": "pluck-nested-user.0",
            "php": "Arr::pluck($nk, 'user.0')",

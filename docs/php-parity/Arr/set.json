        {
            "label": "set-then-get-noncanonical-index",
            "php": "$a = []; Arr::set($a, '01', 5); Arr::get($a, '01')",
            "value": 5
        },
        {
            "label": "set-then-get-noncanonical-index-nested",
            "php": "$a = [[]]; Arr::set($a, '0.01', 5); Arr::get($a, '0.01')",
            "value": {
                "written": [
                    {
                        "01": 5
                    }
                ],
                "read back": 5
            }
        },
        {
            "label": "set-empty-middle-segment",
            "php": "$a = []; Arr::set($a, '0..1', 'V')",

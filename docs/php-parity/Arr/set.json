{
    "meta": {
        "php": "8.5.9",
        "laravel": "v13.35.0-45-g01ac36d93a"
    },
    "probes": [
        {
            "label": "Arr::set preserves a sibling \"__proto__\" key",
            "php": "Arr::set([[\"__proto__\"=>[\"isAdmin\"=>true],\"z\"=>1]],\"0.z\",2)",
            "value": [
                {
                    "__proto__": {
                        "isAdmin": true
                    },
                    "z": 2
                }
            ]
        },
        {
            "label": "Arr::set writes a \"constructor\" key",
            "php": "Arr::set([], \"constructor\", 5)",
            "value": {
                "constructor": 5
            }
        },
        {
            "label": "Arr::set writes a \"prototype\" key",
            "php": "Arr::set([], \"prototype\", 5)",
            "value": {
                "prototype": 5
            }
        },
        {
            "label": "Arr::set writes a nested \"constructor.prototype\" path",
            "php": "Arr::set([], \"constructor.prototype.polluted\", 5)",
            "value": {
                "constructor": {
                    "prototype": {
                        "polluted": 5
                    }
                }
            }
        },
        {
            "label": "Arr::set writes a \"__proto__\" key",
            "php": "Arr::set([], \"__proto__\", 5)",
            "value": {
                "__proto__": 5
            }
        },
        {
            "label": "set-overwrite-nested",
            "php": "set(['products'=>['desk'=>['price'=>100]]], 'products.desk.price', 200)",
            "value": {
                "products": {
                    "desk": {
                        "price": 200
                    }
                }
            }
        },
        {
            "label": "set-scalar-intermediate",
            "php": "set(['products'=>'desk'], 'products.desk.price', 200)",
            "value": {
                "products": {
                    "desk": {
                        "price": 200
                    }
                }
            }
        },
        {
            "label": "set-int-key",
            "php": "set([1=>'test'], 1, 'hAz')",
            "value": {
                "1": "hAz"
            }
        },
        {
            "label": "set-int-key-string",
            "php": "set([1=>'test'], '1', 'hAz')",
            "value": {
                "1": "hAz"
            }
        },
        {
            "label": "set-list-input",
            "php": "set([0=>'products'], 'products.desk.price', 200)",
            "value": {
                "0": "products",
                "products": {
                    "desk": {
                        "price": 200
                    }
                }
            }
        },
        {
            "label": "set-null-array-null-key",
            "php": "$a = null; Arr::set($a, null, 5)",
            "value": {
                "value": 5,
                "array": 5
            }
        },
        {
            "label": "set-creates-missing-path",
            "php": "set(['products'=>['desk'=>['price'=>100]]], 'table.price', 500)",
            "value": {
                "flat write": {
                    "products": {
                        "desk": {
                            "price": 100
                        }
                    },
                    "table": 500
                },
                "then dotted write": {
                    "products": {
                        "desk": {
                            "price": 100
                        }
                    },
                    "table": {
                        "price": 500
                    }
                }
            }
        },
        {
            "label": "set-list-key-cast",
            "php": "Arr::set(['a','b'], $seg, 'V') for $seg in '01','1','-1','1.5',''",
            "value": {
                "01": {
                    "json": {
                        "0": "a",
                        "1": "b",
                        "01": "V"
                    },
                    "keys": [
                        "integer:0",
                        "integer:1",
                        "string:01"
                    ]
                },
                "1": {
                    "json": [
                        "a",
                        "V"
                    ],
                    "keys": [
                        "integer:0",
                        "integer:1"
                    ]
                },
                "-1": {
                    "json": {
                        "0": "a",
                        "1": "b",
                        "-1": "V"
                    },
                    "keys": [
                        "integer:0",
                        "integer:1",
                        "integer:-1"
                    ]
                },
                "1.5": {
                    "json": [
                        "a",
                        {
                            "5": "V"
                        }
                    ],
                    "keys": [
                        "integer:0",
                        "integer:1"
                    ]
                },
                "": {
                    "json": {
                        "0": "a",
                        "1": "b",
                        "": "V"
                    },
                    "keys": [
                        "integer:0",
                        "integer:1",
                        "string:"
                    ]
                }
            }
        },

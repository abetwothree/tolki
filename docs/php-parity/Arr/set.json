        {
            "label": "own-key-channel-round-trip",
            "php": "$a = ['a','b']; Arr::set($a, '01', 'V'); then Arr::get / Arr::has",
            "value": {
                "written": {
                    "json": {
                        "0": "a",
                        "1": "b",
                        "01": "V"
                    },
                    "keys": [
                        "integer:0",
                        "integer:1",
                        "string:01"
                    ]
                },
                "get": "V",
                "has": true
            }
        },
        {
            "label": "e3-own-key-channel-empty-root",
            "php": "$a = []; $a['01'] = 'V'; and $b = []; Arr::set($b, '01', 'V')",
            "value": {
                "raw subscript": {
                    "json": {
                        "01": "V"
                    },
                    "keys": [
                        "string:01"
                    ]
                },
                "Arr::set": {
                    "json": {
                        "01": "V"
                    },
                    "keys": [
                        "string:01"
                    ]
                },
                "get": "V",
                "has": true
            }
        },

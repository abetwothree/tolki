{
    "meta": {
        "php": "8.5.9",
        "laravel": "v13.35.0-45-g01ac36d93a"
    },
    "probes": [
        {
            "label": "add stores a string key on a list",
            "php": "Arr::add(['a','b'],'length','X')",
            "value": {
                "0": "a",
                "1": "b",
                "length": "X"
            }
        },
        {
            "label": "add stores any other string key on a list",
            "php": "Arr::add(['a','b'],'foo','X')",
            "value": {
                "0": "a",
                "1": "b",
                "foo": "X"
            }
        },
        {
            "label": "add-empty-dotted",
            "php": "Arr::add([], 'developer.name', 'Ferid')",
            "value": {
                "developer": {
                    "name": "Ferid"
                }
            }
        },
        {
            "label": "add-int-key",
            "php": "Arr::add([], 1, 'hAz')",
            "value": {
                "1": "hAz"
            }
        },
        {
            "label": "add-float-key",
            "php": "Arr::add([], 1.1, 'hAz')",
            "value": {
                "1": {
                    "1": "hAz"
                }
            }
        },
        {
            "label": "add-leaves-the-caller-value-untouched",
            "php": "$src = [['desk' => 100]]; Arr::add($src, '0.chair', 150)",
            "value": {
                "source": [
                    {
                        "desk": 100
                    }
                ],
                "result": [
                    {
                        "desk": 100,
                        "chair": 150
                    }
                ]
            }
        },
        {
            "label": "add-list-leaves-the-caller-value-untouched",
            "php": "$src = [[100]]; Arr::add($src, '0.1', 150)",
            "value": {
                "source": [
                    [
                        100
                    ]
                ],
                "result": [
                    [
                        100,
                        150
                    ]
                ]
            }
        },
        {
            "label": "add-existing-key-is-a-no-op",
            "php": "$src = [['desk' => 100]]; Arr::add($src, '0.desk', 150)",
            "value": [
                {
                    "desk": 100
                }
            ]
        },
        {
            "label": "add-nested-list-leaves-the-caller-value-untouched",
            "php": "$src = ['products', ['desk']]; Arr::add($src, '1.1', 200)",
            "value": {
                "source": [
                    "products",
                    [
                        "desk"
                    ]
                ],
                "result": [
                    "products",
                    [
                        "desk",
                        200
                    ]
                ]
            }
        },
        {
            "label": "add-nested-record-leaves-the-caller-value-untouched",
            "php": "$src = ['a' => ['z' => 1]]; Arr::add($src, 'a.y', 2)",
            "value": {
                "source": {
                    "a": {
                        "z": 1
                    }
                },
                "result": {
                    "a": {
                        "z": 1,
                        "y": 2
                    }
                }
            }
        },
        {
            "label": "add-nested-object-is-replaced-wholesale",
            "php": "$src = [new D4Point(1)]; Arr::add($src, '0.y', 2)",
            "value": {
                "source": [
                    {
                        "x": 1
                    }
                ],
                "source_type": "D4Point",
                "result": [
                    {
                        "y": 2
                    }
                ],
                "result_type": "array"
            }
        },
        {
            "label": "add-assoc-nested-object-is-replaced-wholesale",
            "php": "$src = ['a' => new D4Point(1)]; Arr::add($src, 'a.y', 2)",
            "value": {
                "source": {
                    "a": {
                        "x": 1
                    }
                },
                "source_type": "D4Point",
                "result": {
                    "a": {
                        "y": 2
                    }
                },
                "result_type": "array"
            }
        },
        {
            "label": "add-nested-arrayaccess-is-replaced-wholesale",
            "php": "$src = [new ArrayObject(['z' => 1])]; Arr::add($src, '0.y', 2)",
            "value": {
                "source_count": 1,
                "result": [
                    {
                        "y": 2
                    }
                ],
                "result_type": "array"
            }
        },
        {
            "label": "d6-nested-list-is-descended-not-replaced",
            "php": "$src = ['a' => ['q']]; Arr::add($src, 'a.1', 'y') and Arr::set($src, 'a.1', 'y')",
            "value": {
                "add": {
                    "a": [
                        "q",
                        "y"
                    ]
                },
                "set": {
                    "a": [
                        "q",
                        "y"
                    ]
                },
                "source-after-add": {
                    "a": [
                        "q"
                    ]
                }
            }
        },
        {
            "label": "d6-nested-list-in-a-list-is-descended",
            "php": "$src = [['q']]; Arr::add($src, '0.1', 'y')",
            "value": {
                "add": [
                    [
                        "q",
                        "y"
                    ]
                ],
                "source-after-add": [
                    [
                        "q"
                    ]
                ]
            }
        },
        {
            "label": "add-over-null-list-value",
            "php": "Arr::add([null], 0, 9)",
            "value": [
                9
            ]
        },
        {
            "label": "add-over-null-keyed-value",
            "php": "Arr::add(['a'=>null], 'a', 9)",
            "value": {
                "a": 9
            }
        },
        {
            "label": "add-over-null-nested-list",
            "php": "Arr::add([['b'=>null]], '0.b', 9)",
            "value": [
                {
                    "b": 9
                }
            ]
        },
        {
            "label": "add-over-null-nested-keyed",
            "php": "Arr::add(['a'=>['b'=>null]], 'a.b', 9)",
            "value": {
                "a": {
                    "b": 9
                }
            }
        },
        {
            "label": "add-leaves-false-alone",
            "php": "Arr::add([false], 0, 9)",
            "value": [
                false
            ]
        },
        {
            "label": "add-leaves-zero-alone",
            "php": "Arr::add(['a'=>0], 'a', 9)",
            "value": {
                "a": 0
            }
        }
    ]
}

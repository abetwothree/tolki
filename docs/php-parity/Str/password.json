{
    "meta": {
        "php": "8.5.9",
        "laravel": "v13.35.0-45-g01ac36d93a"
    },
    "probes": [
        {
            "label": "password-length-below-pool-count",
            "php": "array_map(fn ($n) => strlen(Str::password($n)), [1, 2, 3])",
            "value": [
                1,
                2,
                3
            ]
        },
        {
            "label": "password-zero-length",
            "php": "Str::password(0)",
            "value": ""
        },
        {
            "label": "password-negative-length",
            "php": "Str::password(-2)",
            "value": ""
        },
        {
            "label": "password-no-pools",
            "php": "Str::password(32, false, false, false, false)",
            "threw": "InvalidArgumentException",
            "message": "At least one character pool must be enabled."
        },
        {
            "label": "password-no-pools-zero-length",
            "php": "Str::password(0, false, false, false, false)",
            "threw": "InvalidArgumentException",
            "message": "At least one character pool must be enabled."
        },
        {
            "label": "password-numbers-only",
            "php": "Str::password(5, false, true, false, false)",
            "value": {
                "length": 5,
                "digits": true
            }
        },
        {
            "label": "password-spaces-only",
            "php": "Str::password(3, false, false, false, true)",
            "value": "   "
        }
    ]
}

{
    "name": "@tolki/monorepo",
    "version": "0.0.0",
    "description": "Use the PHP Laravel framework support utilities in your JavaScript codebases",
    "type": "module",
    "private": true,
    "scripts": {
        "release": "pnpm test && pnpm lint:eslint && pnpm format && pnpm document:version && pnpm ci:publish",
        "ci:release": "pnpm test && pnpm lint && pnpm format && pnpm ci:publish",
        "ci:publish": "pnpm publish -r --access=public --no-git-checks --report-summary --provenance",
        "ci:publish-arr": "pnpm publish --filter @tolki/arr --access=public",
        "ci:publish-collection": "pnpm publish --filter @tolki/collection --access=public",
        "ci:publish-data": "pnpm publish --filter @tolki/data --access=public",
        "ci:publish-enum": "pnpm publish --filter @tolki/enum --access=public",
        "ci:publish-lang": "pnpm publish --filter @tolki/lang --access=public",
        "ci:publish-num": "pnpm publish --filter @tolki/num --access=public",
        "ci:publish-obj": "pnpm publish --filter @tolki/obj --access=public",
        "ci:publish-path": "pnpm publish --filter @tolki/path --access=public",
        "ci:publish-str": "pnpm publish --filter @tolki/str --access=public",
        "ci:publish-ts": "pnpm publish --filter @tolki/ts --access=public",
        "ci:publish-types": "pnpm publish --filter @tolki/types --access=public",
        "ci:publish-utils": "pnpm publish --filter @tolki/utils --access=public",
        "build": "run-s build:*",
        "build:arr": "pnpm -F @tolki/arr build",
        "build:collection": "pnpm -F @tolki/collection build",
        "build:data": "pnpm -F @tolki/data build",
        "build:enum": "pnpm -F @tolki/enum build",
        "build:lang": "pnpm -F @tolki/lang build",
        "build:num": "pnpm -F @tolki/num build",
        "build:obj": "pnpm -F @tolki/obj build",
        "build:path": "pnpm -F @tolki/path build",
        "build:str": "pnpm -F @tolki/str build",
        "build:ts": "pnpm -F @tolki/ts build",
        "build:utils": "pnpm -F @tolki/utils build",
        "document:change": "changeset add",
        "document:version": "changeset version",
        "document:empty": "changeset add --empty",
        "clean": "pnpm lint && pnpm format",
        "format": "npx prettier --write . --cache",
        "format:check": "npx prettier --check .",
        "lint": "run-s lint:*",
        "lint:migrate": "rm -f .oxlintrc.json && npx @oxlint/migrate eslint.config.mts --with-nursery && node -e \"const{readFileSync:r,writeFileSync:w}=await import('node:fs');const c=JSON.parse(r('.oxlintrc.json','utf8'));c.overrides=(c.overrides||[]).filter(o=>!(o.jsPlugins||[]).some(p=>p.includes('@eslint/')));w('.oxlintrc.json',JSON.stringify(c,null,4))\" && prettier --write .oxlintrc.json",
        "lint:oxlint": "npx oxlint --fix -D correctness --ignore-path .gitignore",
        "lint:eslint": "npx eslint . --fix",
        "test": "vitest --run --coverage",
        "test:dev": "vitest --coverage",
        "test:ui": "vitest --ui --coverage",
        "ts:check": "tsc --incremental --noEmit --pretty",
        "docs:dev": "vitepress dev docs/vitepress",
        "docs:build": "vitepress build docs/vitepress",
        "docs:preview": "vitepress preview docs/vitepress",
        "docs:coverage": "ts-node ./scripts/docs-coverage.ts",
        "list:functions": "ts-node ./scripts/functions-list.ts",
        "stubs": "run-s stubs:*",
        "stubs:pull": "ts-node ./scripts/pull-framework-repos.ts",
        "stubs:copy-framework": "ts-node ./scripts/copy-framework-files.ts",
        "stubs:copy-docs": "ts-node ./scripts/copy-framework-docs-files.ts && npx prettier --write docs/stubs --cache",
        "stubs:create-lists": "ts-node ./scripts/stubs-function-list-create.ts",
        "stubs:php-parity": "pnpm php:parity",
        "readme:build": "ts-node ./scripts/readme-build.ts",
        "php:parity": "for f in scripts/php-parity/*/*.php; do r=\"${f#scripts/php-parity/}\"; o=\"docs/php-parity/${r%.php}.json\"; mkdir -p \"$(dirname \"$o\")\"; php -d display_errors=stderr \"$f\" > \"$o.tmp\" && mv \"$o.tmp\" \"$o\" || { rm -f \"$o.tmp\"; echo \"FAILED: $f\" >&2; exit 1; }; done"
    },
    "keywords": [],
    "author": "",
    "license": "MIT",
    "packageManager": "pnpm@10.12.1",
    "devDependencies": {
        "@changesets/cli": "^3.0.3",
        "@eslint/css": "^2.0.1",
        "@eslint/js": "^10.0.1",
        "@eslint/json": "^2.1.1",
        "@eslint/markdown": "^8.0.3",
        "@oxlint/migrate": "^1.90.0",
        "@tolki/all": "workspace:^",
        "@tolki/arr": "workspace:^",
        "@tolki/collection": "workspace:^",
        "@tolki/data": "workspace:^",
        "@tolki/enum": "workspace:^",
        "@tolki/lang": "workspace:^",
        "@tolki/num": "workspace:^",
        "@tolki/obj": "workspace:^",
        "@tolki/path": "workspace:^",
        "@tolki/str": "workspace:^",
        "@tolki/types": "workspace:^",
        "@tolki/utils": "workspace:^",
        "@types/lodash": "^4.17.27",
        "@types/lodash-es": "^4.17.12",
        "@types/node": "^26.6.6",
        "@vitest/coverage-istanbul": "^5.0.5",
        "@vitest/ui": "^5.0.5",
        "dotenv": "^18.0.9",
        "eslint": "^10.13.0",
        "eslint-plugin-oxlint": "^1.90.0",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "glob": "^14.0.3",
        "globals": "^17.13.0",
        "jiti": "^2.7.0",
        "jsdom": "^30.1.3",
        "lodash": "^4.18.1",
        "npm-run-all2": "^9.0.4",
        "oxlint": "^1.90.0",
        "path": "^0.12.7",
        "prettier": "3.8.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^7.3.7",
        "vite-plugin-dts": "^4.5.4",
        "vitepress": "2.0.0-alpha.17",
        "vitepress-plugin-group-icons": "^1.8.1",
        "vitepress-plugin-llms": "^1.14.0",
        "vitest": "^5.0.5"
    }
}
